@router.callback_query(F.data.startswith("history_"))
async def show_history(callback: CallbackQuery):
    page = int(callback.data.split("_")[1])
    user_id = callback.from_user.id
    per_page = 5
    
    async with aiosqlite.connect(DB_NAME) as db:
        cur = await db.execute("SELECT COUNT(*) FROM history WHERE user_id = ?", (user_id,))
        total = (await cur.fetchone())[0]
        
        if total == 0:
            await callback.message.edit_text(
                "📋 *История операций*\n\nПока нет операций.",
                parse_mode="Markdown",
                reply_markup=InlineKeyboardBuilder().add(
                    InlineKeyboardButton(text="❌ Закрыть", callback_data="cancel_action")
                ).as_markup()
            )
            await callback.answer()
            return
        
        total_pages = (total + per_page - 1) // per_page
        offset = (page - 1) * per_page
        
        cur = await db.execute(
            "SELECT type, number, amount_usd, status, created_at FROM history WHERE user_id = ? ORDER BY id DESC LIMIT ? OFFSET ?",
            (user_id, per_page, offset)
        )
        rows = await cur.fetchall()
    
    text = f"📋 *История операций* (стр. {page}/{total_pages})\n\n"
    
    for type_, number, amount, status, date in rows:
        icon = "📤" if type_ == "sms" else "📱"
        status_icon = {"success": "✅", "failed": "❌", "pending": "⏳"}.get(status, "❓")
        amount_text = f"+{amount}$" if status == "success" else "0$"
        date_text = date[:16] if date else "???"
        
        text += f"{icon} {status_icon} `{number}` — *{amount_text}*\n└ {date_text}\n\n"
    
    await callback.message.edit_text(
        text,
        parse_mode="Markdown",
        reply_markup=history_keyboard(page, total_pages)
    )
    await callback.answer()

