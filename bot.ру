async def add_to_queue(user_id: int, username: str, queue_type: str, number: str = None):
    queue = number_queue if queue_type == "number" else qr_queue
    entry = {"user_id": user_id, "username": username, "vip": await is_vip(user_id), "number": number, "timestamp": datetime.now()}
    queue.append(entry)
    sorted_list = sorted(queue, key=lambda x: (not x["vip"], x["timestamp"]))
    queue.clear(); queue.extend(sorted_list)
    for i, item in enumerate(queue):
        if item["user_id"] == user_id: return i + 1
    return -1

async def process_next_in_queue(queue_type: str):
    queue = number_queue if queue_type == "number" else qr_queue
    return queue.popleft() if queue else None

async def process_reward_after_hold(number_id: int, user_id: int, number: str, reward: float):
    hold_minutes = int(await get_setting('hold_minutes'))
    await asyncio.sleep(hold_minutes * 60)
    if number_id not in pending_rewards: return
    ref_bonus = float(await get_setting('referral_bonus'))
    for _ in range(10):
        try:
            async with aiosqlite.connect(DB_NAME, timeout=30) as db:
                await db.execute("PRAGMA busy_timeout=5000")
                cur = await db.execute("SELECT status FROM numbers WHERE id = ?", (number_id,))
                row = await cur.fetchone()
                if not row or row[0] == 'failed':
                    if number_id in pending_rewards: del pending_rewards[number_id]
                    return
                if row[0] == 'success_hold':
                    await db.execute("UPDATE users SET balance_rub = balance_rub + ?, total_earned = total_earned + ?, numbers_success = numbers_success + 1 WHERE user_id = ?", (reward * USD_RATE, reward * USD_RATE, user_id))
                    cur_ref = await db.execute("SELECT referred_by FROM users WHERE user_id = ?", (user_id,))
                    ref_row = await cur_ref.fetchone()
                    if ref_row and ref_row[0]:
                        await db.execute("UPDATE users SET balance_rub = balance_rub + ? WHERE user_id = ?", (ref_bonus * USD_RATE, ref_row[0]))
                        try: await bot.send_message(ref_row[0], f"🎁 <b>Реферальный бонус:</b> +{ref_bonus}$!", parse_mode="HTML")
                        except: pass
                    await db.execute("UPDATE numbers SET status = 'success', completed_at = CURRENT_TIMESTAMP WHERE id = ?", (number_id,))
                    today = datetime.now().strftime("%Y-%m-%d")
                    await db.execute("INSERT INTO daily_stats (user_id, date, success_count) VALUES (?, ?, 1) ON CONFLICT(user_id, date) DO UPDATE SET success_count = success_count + 1", (user_id, today))
                    await db.commit()
                    cur = await db.execute("SELECT balance_rub FROM users WHERE user_id = ?", (user_id,))
                    bal = round((await cur.fetchone())[0] / USD_RATE, 2)
                    v = " (+VIP 💎)" if await is_vip(user_id) else ""
                    await bot.send_message(user_id, f"✅ <b>Холд завершён!</b>\n\n💰 Начислено: <b>{reward}${v}</b> ({reward * USD_RATE}₽)\n💳 Баланс: <b>{bal}$</b>\n📱 Номер: <code>{number}</code>\n\n<i>Спасибо за работу! 🎉</i>", parse_mode="HTML")
                if number_id in pending_rewards: del pending_rewards[number_id]
                return
        except Exception as e:
            logging.error(f"Холд ошибка: {e}")
            await asyncio.sleep(0.5)
    if number_id in pending_rewards: del pending_rewards[number_id]

