@router.message(WithdrawStates.amount)
async def withdraw_process(message: Message, state: FSMContext):
    user_id = message.from_user.id
    username = message.from_user.username or f"id{user_id}"

    try:
        amount = float(message.text.strip())
        if amount != int(amount):
            await message.answer("❌ Введи целое число!")
            return
    except:
        await message.answer("❌ Введи число!")
        return

    async with aiosqlite.connect(DB_NAME) as db:
        cur = await db.execute("SELECT balance_rub FROM users WHERE user_id = ?", (user_id,))
        row = await cur.fetchone()
        balance_usd = round(row[0] / USD_RATE, 2)

    if amount < MIN_WITHDRAW_USD or amount > balance_usd:
        await message.answer(f"❌ Сумма должна быть от {MIN_WITHDRAW_USD}$ до {balance_usd}$")
        return

    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute(
            "UPDATE users SET balance_rub = balance_rub - ? WHERE user_id = ?",
            (amount * USD_RATE, user_id)
        )
        await db.commit()

    for admin_id in ADMIN_IDS:
        try:
            admin_msg = await bot.send_message(
                admin_id,
                f"💸 *Заявка на вывод # {user_id}*\n\n"
                f"👤 @{username} (ID: `{user_id}`)\n"
                f"💰 Сумма: *{amount}$*\n\n"
                f"*Ответьте на это сообщение ссылкой на чек для подтверждения*",
                parse_mode="Markdown"
            )
            async with aiosqlite.connect(DB_NAME) as db:
                await db.execute(
                    "INSERT INTO withdraw_requests (user_id, amount_usd, admin_msg_id) VALUES (?, ?, ?)",
                    (user_id, amount, admin_msg.message_id)
                )
                await db.commit()
        except:
            pass

    await message.answer(
        f"✅ Заявка на вывод *{amount}$* создана!\nОжидайте чек от администратора.",
        parse_mode="Markdown",
        reply_markup=main_menu()
    )
    await state.clear()

@router.message(F.reply_to_message)
async def admin_check_response(message: Message):
    if message.from_user.id not in ADMIN_IDS:
        return

    replied_text = message.reply_to_message.text or ""

    if "Заявка на вывод #" not in replied_text:
        return

    match = re.search(r'ID: `(\d+)`', replied_text)
    if not match:
        return
    user_id = int(match.group(1))

    match_sum = re.search(r'Сумма: \*([\d.]+)\$\*', replied_text)
    amount = match_sum.group(1) if match_sum else "?"

    check_text = message.text or "Чек отправлен"
    try:
        await bot.send_message(
            user_id,
            f"💸 *Вывод на {amount}$ выполнен!*\n\n"
            f"📝 Чек: {check_text}\n\n"
            f"Спасибо за работу! 🎉",
            parse_mode="Markdown"
        )
        await message.reply(f"✅ Чек отправлен пользователю `{user_id}`", parse_mode="Markdown")

        async with aiosqlite.connect(DB_NAME) as db:
            await db.execute(
                "UPDATE withdraw_requests SET status = 'completed' WHERE admin_msg_id = ?",
                (message.reply_to_message.message_id,)
            )
            await db.commit()
    except Exception as e:
        await message.reply(f"❌ Ошибка отправки: {e}")

