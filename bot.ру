@router.message(F.text == "📤 Сдать номер")
async def start_submit(message: Message, state: FSMContext):
    user_id = message.from_user.id

    if not await check_subscription(user_id):
        await message.answer("⚠️ Подпишись на канал:", reply_markup=check_sub_keyboard())
        return

    accepting = await get_setting('accepting_enabled')
    if accepting != '1':
        await message.answer("⏸️ Приём номеров временно приостановлен.")
        return

    async with aiosqlite.connect(DB_NAME) as db:
        cur = await db.execute("SELECT is_banned FROM users WHERE user_id = ?", (user_id,))
        row = await cur.fetchone()
        if row and row[0]:
            await message.answer("⛔ Вы заблокированы.")
            return

    if await check_spam(user_id):
        await message.answer(f"⏳ Слишком часто! Подождите {SPAM_LIMIT_SECONDS} секунд.")
        return

    await message.answer("✏️ Введи номер телефона в формате: `+79001234567`", parse_mode="Markdown")
    await state.set_state(SubmitNumber.enter_number)

@router.message(SubmitNumber.enter_number)
async def number_entered(message: Message, state: FSMContext):
    number = message.text.strip()
    user_id = message.from_user.id
    username = message.from_user.username or f"id{user_id}"

    if not number.startswith("+7") or len(number) != 12:
        await message.answer("❌ Неверный формат. Пример: +79001234567")
        return

    if await check_duplicate_number(number):
        await message.answer("❌ Этот номер уже был успешно использован ранее!")
        await state.clear()
        return

    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute(
            "UPDATE users SET last_submit_time = ? WHERE user_id = ?",
            (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), user_id)
        )
        await db.execute(
            "UPDATE users SET numbers_submitted = numbers_submitted + 1 WHERE user_id = ?",
            (user_id,)
        )
        await db.commit()

    position = await add_to_queue(user_id, username, "number", number)
    
    # Проверка достижений
    await check_achievement(user_id, "first_number", 1)
    async with aiosqlite.connect(DB_NAME) as db:
        cur = await db.execute("SELECT numbers_submitted FROM users WHERE user_id = ?", (user_id,))
        row = await cur.fetchone()
        if row:
            await check_achievement(user_id, "ten_numbers", row[0])
            await check_achievement(user_id, "fifty_numbers", row[0])
            await check_achievement(user_id, "hundred_numbers", row[0])
    
    await message.answer(
        f"✅ Номер `{number}` добавлен в очередь!\n"
        f"📊 Твоя позиция: *{position}*\n"
        f"👥 В очереди: {len(number_queue)} чел.\n\n"
        f"Ожидай, когда твой номер возьмут в обработку.",
        parse_mode="Markdown",
        reply_markup=main_menu()
    )
    await state.clear()

