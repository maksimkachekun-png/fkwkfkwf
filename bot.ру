@router.message(CommandStart())
async def start(message: Message):
    user_id = message.from_user.id
    async with aiosqlite.connect(DB_NAME, timeout=10) as db:
        cur = await db.execute("SELECT user_id FROM users WHERE user_id = ?", (user_id,))
        if not await cur.fetchone():
            own_ref = ''.join(random.choices(string.ascii_letters + string.digits, k=8))
            ref_code = message.text.split()[1] if len(message.text.split()) > 1 else None
            referred_by = None
            if ref_code:
                cur = await db.execute("SELECT user_id FROM users WHERE referral_code = ?", (ref_code,))
                ref = await cur.fetchone()
                if ref and ref[0] != user_id: referred_by = ref[0]
            await db.execute("INSERT INTO users (user_id, username, referral_code, referred_by) VALUES (?, ?, ?, ?)", (user_id, message.from_user.username or "нет", own_ref, referred_by))
            await db.commit()
    if await check_subscription(user_id): await message.answer("✅ <b>Добро пожаловать!</b>\n\nИспользуй кнопки ниже для работы с ботом.", parse_mode="HTML", reply_markup=main_menu())
    else: await message.answer("⚠️ <b>Подпишись на канал:</b>", parse_mode="HTML", reply_markup=check_sub_keyboard())

