    await state.clear()

@router.message(F.reply_to_message)
async def admin_check_response(message: Message):
    if message.from_user.id not in ADMIN_IDS:
        return

    if "Заявка на вывод #" not in (message.reply_to_message.text or ""):
        return

    match = re.search(r'ID: `(\d+)`', message.reply_to_message.text)
    if not match: return
    user_id = int(match.group(1))

    match_sum = re.search(r'Сумма: \*([\d.]+)\$\*', message.reply_to_message.text)
