@router.message(CommandStart())
async def start(message: Message):
    user_id = message.from_user.id
    username = message.from_user.username or "нет"
    ref_code = message.text.split()[1] if len(message.text.split()) > 1 else None

    async with aiosqlite.connect(DB_NAME) as db:
        cursor = await db.execute("SELECT user_id FROM users WHERE user_id = ?", (user_id,))
        if not await cursor.fetchone():
            own_ref = ''.join(random.choices(string.ascii_letters + string.digits, k=8))
            referred_by = None
            if ref_code:
                cur = await db.execute("SELECT user_id FROM users WHERE referral_code = ?", (ref_code,))
                ref = await cur.fetchone()
                if ref and ref[0] != user_id:
                    referred_by = ref[0]

            await db.execute(
                "INSERT INTO users (user_id, username, referral_code, referred_by) VALUES (?, ?, ?, ?)",
                (user_id, username, own_ref, referred_by)
            )
            await db.commit()

    if await check_subscription(user_id):
        await message.answer("✅ Добро пожаловать!", reply_markup=main_menu())
    else:
        await message.answer("⚠️ Подпишись на канал:", reply_markup=check_sub_keyboard())

