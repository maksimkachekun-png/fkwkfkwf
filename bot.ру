            return
        
        cur = await db.execute("""
            SELECT user_id, SUM(success_count) as total 
            FROM daily_stats 
            WHERE date >= ? 
            GROUP BY user_id 
            ORDER BY total DESC 
            LIMIT 10
        """, (week_ago,))
        rows = await cur.fetchall()
    
    if not rows:
        await message.answer("🏅 Топ недели пуст.")
        return
    
    text = "🏅 *Топ недели*\n\n"
    medals = ["🥇", "🥈", "🥉"]
    for i, (uid, count) in enumerate(rows, 1):
        medal = medals[i-1] if i <= 3 else f"{i}."
        text += f"{medal} ID: `{uid}` — {count} номеров\n"
    
    await message.answer(text, parse_mode="Markdown")

