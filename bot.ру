    replied_msg = message.reply_to_message
    if not replied_msg or "QR из очереди" not in (replied_msg.text or ""):
        return

    match_id = re.search(r'ID: (\d+)', replied_msg.text)
    match_user = re.search(r'\(ID: `(\d+)`\)', replied_msg.text)
    
    if not match_id or not match_user:
