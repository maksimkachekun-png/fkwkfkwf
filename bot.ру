async def auto_prizes():
    while True:
        now = datetime.now()
        days_until_monday = (7 - now.weekday()) % 7
        if days_until_monday == 0: days_until_monday = 7
        next_monday = (now + timedelta(days=days_until_monday)).replace(hour=0, minute=0, second=0, microsecond=0)
        await asyncio.sleep((next_monday - now).total_seconds())
        week_ago = (datetime.now() - timedelta(days=7)).strftime("%Y-%m-%d")
        async with aiosqlite.connect(DB_NAME, timeout=10) as db:
            cur = await db.execute("SELECT user_id, SUM(success_count) FROM daily_stats WHERE date >= ? GROUP BY user_id ORDER BY SUM(success_count) DESC LIMIT 3", (week_ago,))
            rows = await cur.fetchall()
        prizes = [float(await get_setting('prize_1')), float(await get_setting('prize_2')), float(await get_setting('prize_3'))]
        for i, (uid, _) in enumerate(rows):
            async with aiosqlite.connect(DB_NAME, timeout=10) as db:
                await db.execute("UPDATE users SET balance_rub = balance_rub + ? WHERE user_id = ?", (prizes[i] * USD_RATE, uid))
                await db.commit()
            try: await bot.send_message(uid, f"🏆 {i+1} место в топе недели!\n💰 Приз: {prizes[i]}$ начислен!", parse_mode="Markdown")
            except: pass

