    text += "*Номера:*\n"
    if number_queue:
        for i, entry in enumerate(number_queue, 1):
            vip = "💎" if entry["vip"] else ""
            text += f"{i}. {vip} @{entry['username']} - `{entry['number']}`\n"
    else:
        text += "Пусто\n"
    
    text += "\n*QR:*\n"
    if qr_queue:
        for i, entry in enumerate(qr_queue, 1):
            vip = "💎" if entry["vip"] else ""
            text += f"{i}. {vip} @{entry['username']}\n"
    else:
        text += "Пусто"
    
    await message.answer(text, parse_mode="Markdown")

