async def check_subscription(user_id: int) -> bool:
    try:
        member = await bot.get_chat_member(CHANNEL_ID, user_id)
        return member.status not in ["left", "kicked"]
    except:
        return False

async def is_vip(user_id: int) -> bool:
    async with aiosqlite.connect(DB_NAME) as db:
        cur = await db.execute("SELECT is_vip, vip_until FROM users WHERE user_id = ?", (user_id,))
        row = await cur.fetchone()
        if row and row[0] == 1 and row[1]:
            return datetime.strptime(row[1], "%Y-%m-%d %H:%M:%S") > datetime.now()
        return False

async def check_duplicate_number(number: str) -> bool:
    async with aiosqlite.connect(DB_NAME) as db:
        cur = await db.execute("SELECT COUNT(*) FROM numbers WHERE number = ? AND status = 'success'", (number,))
        row = await cur.fetchone()
        return row[0] > 0

async def check_spam(user_id: int) -> bool:
    async with aiosqlite.connect(DB_NAME) as db:
        cur = await db.execute("SELECT last_submit_time FROM users WHERE user_id = ?", (user_id,))
        row = await cur.fetchone()
        if row and row[0]:
            last_time = datetime.strptime(row[0], "%Y-%m-%d %H:%M:%S")
            return (datetime.now() - last_time).total_seconds() < SPAM_LIMIT_SECONDS
        return False

async def add_to_queue(user_id: int, username: str, queue_type: str, number: str = None):
    queue = number_queue if queue_type == "number" else qr_queue
    is_user_vip = await is_vip(user_id)
    
    entry = {
        "user_id": user_id,
        "username": username,
        "vip": is_user_vip,
        "number": number,
        "timestamp": datetime.now()
    }
    
    queue.append(entry)
    sorted_list = sorted(queue, key=lambda x: (not x["vip"], x["timestamp"]))
    queue.clear()
    queue.extend(sorted_list)
    
    for i, item in enumerate(queue):
        if item["user_id"] == user_id:
            return i + 1
    return -1

async def process_next_in_queue(queue_type: str):
    queue = number_queue if queue_type == "number" else qr_queue
    if not queue:
        return None
    return queue.popleft()

async def process_reward_after_hold(number_id: int, user_id: int, number: str, reward: float):
    await asyncio.sleep(300)  # 5 минут
    
    if number_id not in pending_rewards:
        return
    
    ref_bonus = float(await get_setting('referral_bonus'))
    
    async with aiosqlite.connect(DB_NAME) as db:
        cur = await db.execute("SELECT status FROM numbers WHERE id = ?", (number_id,))
        row = await cur.fetchone()
        if row and row[0] == 'failed':
            return
        
        await db.execute(
            "UPDATE users SET balance_rub = balance_rub + ?, total_earned = total_earned + ?, numbers_success = numbers_success + 1 WHERE user_id = ?",
            (reward * USD_RATE, reward * USD_RATE, user_id))
        
        cur_ref = await db.execute("SELECT referred_by FROM users WHERE user_id = ?", (user_id,))
        ref_row = await cur_ref.fetchone()
        if ref_row and ref_row[0]:
            await db.execute("UPDATE users SET balance_rub = balance_rub + ? WHERE user_id = ?", 
                           (ref_bonus * USD_RATE, ref_row[0]))
            try:
                await bot.send_message(ref_row[0], f"🎁 Реферальный бонус: +{ref_bonus}$!")
            except:
                pass
        
        await db.execute("UPDATE numbers SET status = 'success', completed_at = CURRENT_TIMESTAMP WHERE id = ?", (number_id,))
        
        today = datetime.now().strftime("%Y-%m-%d")
        await db.execute("""
            INSERT INTO daily_stats (user_id, date, success_count) 
            VALUES (?, ?, 1) 
            ON CONFLICT(user_id, date) 
            DO UPDATE SET success_count = success_count + 1
        """, (user_id, today))
        
        await add_history(user_id, "sms", number, reward, "success")
        await db.commit()
    
    vip_text = " (+VIP)" if await is_vip(user_id) else ""
    await bot.send_message(
        user_id,
        f"✅ Холд завершён!\n💰 Начислено: *{reward}${vip_text}* ({reward * USD_RATE}₽)\nНомер: `{number}`",
        parse_mode="Markdown"
    )
    
    if number_id in pending_rewards:
        del pending_rewards[number_id]

