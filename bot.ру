@router.message(SubmitNumber.enter_number)
async def number_entered(message: Message, state: FSMContext):
    number = message.text.strip()
    user_id = message.from_user.id
    username = message.from_user.username or f"id{user_id}"

    if not number.startswith("+7") or len(number) != 12:
        await message.answer(
            "❌ Неверный формат. Пример: +79001234567\nПопробуй ещё раз или нажми отменить:",
            reply_markup=cancel_keyboard()
        )
        return

    if await check_duplicate_number(number):
        await message.answer("❌ Этот номер уже был успешно использован!")
        await state.clear()
        return

    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute("UPDATE users SET last_submit_time = ?, numbers_submitted = numbers_submitted + 1 WHERE user_id = ?",
                         (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), user_id))
        await db.commit()

