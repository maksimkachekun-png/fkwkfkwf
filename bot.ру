    qr_id = int(match_id.group(1))
    user_id = int(match_user.group(1))
    photo_id = message.photo[-1].file_id

    async with aiosqlite.connect(DB_NAME) as db:
        await db.execute("UPDATE numbers SET photo_id = ? WHERE id = ?", (photo_id, qr_id))
        await db.commit()

    await bot.send_photo(
        user_id,
        photo_id,
        caption="📱 *QR код для сканирования*\nНажми кнопку после сканирования:",
        parse_mode="Markdown",
        reply_markup=qr_user_keyboard(qr_id)
    )

