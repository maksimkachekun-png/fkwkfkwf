        await db.execute("UPDATE numbers SET message_id = ? WHERE id = ?", (msg.message_id, nid)); await db.commit()
    await bot.send_message(entry["user_id"], f"📱 `{entry['number']}` в обработке!", parse_mode="Markdown")
    await callback.answer()

