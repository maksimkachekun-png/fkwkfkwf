@router.callback_query(F.data == "request_number")
async def request_number_from_queue(callback: CallbackQuery):
    entry = await process_next_in_queue("number")
    if not entry: await callback.answer("❌ Пусто!", show_alert=True); return
    tid = callback.message.message_thread_id
    async with aiosqlite.connect(DB_NAME, timeout=10) as db:
        cur = await db.execute("INSERT INTO numbers (user_id, number, type, thread_id) VALUES (?, ?, 'sms', ?)", (entry["user_id"], entry["number"], tid))
        nid = cur.lastrowid; await db.commit()
    v = "💎 VIP | " if entry["vip"] else ""
    msg = await bot.send_message(GROUP_ID, f"📱 *Номер*\n{v}👤 @{entry['username']} (ID: `{entry['user_id']}`)\n🔢 `{entry['number']}`\n🆔 {nid}\n📊 {len(number_queue)} чел.", parse_mode="Markdown", reply_markup=number_action_keyboard(nid), message_thread_id=tid)
